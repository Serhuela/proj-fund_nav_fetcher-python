<mxfile host="app.diagrams.net" version="24.7.17" type="device">
  <diagram id="fund-class-diagram" name="Clases - alta de fondo">
    <mxGraphModel dx="1280" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Diagrama de clases · alta de un fondo&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#263238;" vertex="1" parent="1">
          <mxGeometry x="45" y="25" width="1175" height="55" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="DataService coordina una operación; el repositorio de fondos usa una conexión PostgreSQL compartida" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#546e7a;" vertex="1" parent="1">
          <mxGeometry x="45" y="82" width="1175" height="32" as="geometry" />
        </mxCell>
        <mxCell id="heading_service" value="&lt;b&gt;1 · Servicio de aplicación&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#8055a6;" vertex="1" parent="1">
          <mxGeometry x="45" y="140" width="350" height="32" as="geometry" />
