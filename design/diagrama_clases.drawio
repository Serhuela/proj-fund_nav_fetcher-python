        <mxCell id="data_service" value="&lt;div style=&quot;padding:5px 10px;background-color:#f2e8ff;border-bottom:1px solid #8055a6;&quot;&gt;&lt;i&gt;servicio de aplicación&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:16px&quot;&gt;DataService&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding:5px 10px;&quot;&gt;+ register_fund(isin, name, currency): Fund&lt;br&gt;&lt;br&gt;Valida las entradas y coordina el alta.&lt;br&gt;Decide el commit o rollback de la operación.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#ffffff;strokeColor=#8055a6;fontColor=#263238;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="180" width="350" height="190" as="geometry" />
        </mxCell>
        <mxCell id="repository" value="&lt;div style=&quot;padding:5px 10px;background-color:#e6f4ea;border-bottom:1px solid #4d8a5c;&quot;&gt;&lt;i&gt;clase abstracta · contrato común&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:16px&quot;&gt;Repository&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding:5px 10px;&quot;&gt;+ __init__(postgres: Postgres)&lt;br&gt;Comparte la dependencia de persistencia.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#ffffff;strokeColor=#4d8a5c;fontColor=#263238;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="455" y="180" width="330" height="145" as="geometry" />
        </mxCell>
        <mxCell id="funds_repository" value="&lt;div style=&quot;padding:5px 10px;background-color:#e8f1fb;border-bottom:1px solid #5279a7;&quot;&gt;&lt;i&gt;repositorio concreto&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:16px&quot;&gt;FundsRepository&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding:5px 10px;&quot;&gt;+ create(isin, name, currency): Fund&lt;br&gt;&lt;br&gt;Conoce la tabla funds y sus columnas.&lt;br&gt;Construye la consulta y mapea la fila a Fund.&lt;br&gt;No confirma la transacción ni llama a otros repositorios.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#ffffff;strokeColor=#5279a7;fontColor=#263238;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="455" y="455" width="350" height="210" as="geometry" />
        </mxCell>
        <mxCell id="postgres" value="&lt;div style=&quot;padding:5px 10px;background-color:#e8f1fb;border-bottom:1px solid #5279a7;&quot;&gt;&lt;i&gt;conexión y ejecución PostgreSQL&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:16px&quot;&gt;Postgres&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding:5px 10px;&quot;&gt;+ execute(query, parameters): row&lt;br&gt;+ commit()&lt;br&gt;+ rollback()&lt;br&gt;&lt;br&gt;Mantiene la conexión compartida durante la operación.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#ffffff;strokeColor=#5279a7;fontColor=#263238;fontSize=14;" vertex="1" parent="1">
