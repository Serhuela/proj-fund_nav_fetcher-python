          <mxGeometry x="455" y="140" width="350" height="32" as="geometry" />
        </mxCell>
        <mxCell id="heading_postgres" value="&lt;b&gt;3 · Persistencia PostgreSQL&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#5279a7;" vertex="1" parent="1">
          <mxGeometry x="875" y="260" width="350" height="32" as="geometry" />
